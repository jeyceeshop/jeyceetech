# Optional server-only review storage. Configure actual values securely in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for direct contact-form email. Set securely in Vercel (server only).
# Use credentials for the actual mailbox, not a separate password per alias.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=hello@jeycee.shop
SMTP_PASS=
# Optional dedicated signing key. Otherwise the server derives a contact-only
# signing context from SMTP_PASS. Never use VITE_ prefixes for these secrets.
ANTISPAM_SECRET=

# Portal de pedidos/tickets. Ejecuta database/portal.sql antes de activarlo.
# Reutiliza SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY de arriba.
PORTAL_ENABLED=false
# Mínimo 12 caracteres. Elige una contraseña larga y exclusiva en Vercel.
ADMIN_PASSWORD=
# Clave aleatoria independiente de al menos 32 caracteres (openssl rand -hex 32).
ADMIN_SESSION_SECRET=
# Origen HTTPS para los enlaces privados que se envían por correo.
PUBLIC_SITE_URL=https://jeycee-tech.vercel.app
