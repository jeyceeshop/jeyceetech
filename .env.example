# Optional server-only review storage. Configure actual values securely in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for direct contact-form email. Set securely in Vercel (server only).
# Use credentials for the actual mailbox, not a separate password per alias.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=hello@jeycee.shop
SMTP_PASS=
# Optional dedicated signing key. Otherwise the server derives a contact-only
# signing context from SMTP_PASS. Never use VITE_ prefixes for these secrets.
ANTISPAM_SECRET=
