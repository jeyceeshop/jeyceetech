{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/soporte",
      "destination": "/contacto?tipo=soporte",
      "permanent": true
    }
  ],
  "functions": {
    "api/contact.js": {
      "maxDuration": 60
    }
  }
}
